{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rrmodmanager.example/schemas/manifest.schema.json",
  "title": "RR Mod Manager Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "name", "version", "game", "components"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n\\u0000]+$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\r\\n\\u0000]+$" },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["steam_app_id", "supported_build_ids", "unreal_engine"],
      "properties": {
        "steam_app_id": { "const": 3552140 },
        "supported_build_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[1-9][0-9]{0,18}$" }
        },
        "unreal_engine": { "const": "5.4.4" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider"],
      "properties": {
        "provider": { "enum": ["nexus", "github", "local", "other"] },
        "game_domain": { "type": "string", "minLength": 1 },
        "mod_id": { "type": "integer", "minimum": 1 },
        "file_id": { "type": ["integer", "null"], "minimum": 1 },
        "url": { "type": "string", "format": "uri", "pattern": "^https?://" }
      },
      "allOf": [
        {
          "if": { "properties": { "provider": { "const": "nexus" } }, "required": ["provider"] },
          "then": {
            "required": ["game_domain", "mod_id"],
            "properties": { "game_domain": {}, "mod_id": {} }
          }
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "root"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
          "type": { "enum": ["pak", "ue4ss", "config", "documentation", "native"] },
          "root": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean", "default": true },
          "install_name": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$"
          },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        },
        "allOf": [
          {
            "if": { "properties": { "type": { "const": "pak" } }, "required": ["type"] },
            "then": {
              "required": ["install_name", "sha256"],
              "properties": {
                "install_name": { "type": "string", "pattern": "^[^/\\\\]+\\.[pP][aA][kK]$" },
                "sha256": {}
              }
            }
          },
          {
            "if": { "properties": { "type": { "const": "ue4ss" } }, "required": ["type"] },
            "then": {
              "required": ["install_name"],
              "properties": { "install_name": { "type": "string", "pattern": "^[^/\\\\]+$" } }
            }
          }
        ]
      }
    },
    "variants": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
          "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\r\\n\\u0000]+$" },
          "default": { "type": "boolean", "default": false },
          "components": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
            "default": []
          },
          "requirements": {
            "type": "array",
            "items": { "$ref": "#/$defs/requirement" },
            "default": []
          },
          "incompatibilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
            "default": []
          }
        }
      }
    },
    "requirements": {
      "type": "array",
      "items": { "$ref": "#/$defs/requirement" },
      "default": []
    },
    "runtime_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ue4ss_loader_policy": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
        }
      },
      "default": {}
    },
    "incompatibilities": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
      "default": []
    },
    "replaces": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
      "default": []
    },
    "persistent_effects": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" }, "default": [] },
    "install_notes": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\r\\n\\u0000]+$" }, "default": [] }
  },
  "$defs": {
    "requirement": {
      "oneOf": [
        { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["one_of"],
          "properties": {
            "one_of": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$" }
            }
          }
        }
      ]
    }
  }
}
