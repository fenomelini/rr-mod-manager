FROM node:24-bookworm

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      build-essential curl file libayatana-appindicator3-dev librsvg2-dev \
      libssl-dev libwebkit2gtk-4.1-dev libxdo-dev patchelf wget xdg-utils && \
    rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/opt/rustup
ENV CARGO_HOME=/opt/cargo
ENV PATH=/opt/cargo/bin:/usr/local/bin:/usr/bin

RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
      sh -s -- -y --default-toolchain 1.97.1 --profile minimal && \
    chmod -R a+rX /opt/rustup /opt/cargo && \
    corepack enable && corepack prepare pnpm@10.13.1 --activate

ARG APPIMAGETOOL_SHA256=a6d71e2b6cd66f8e8d16c37ad164658985e0cf5fcaa950c90a482890cb9d13e0
RUN curl --proto '=https' --tlsv1.2 -fL \
      https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
      -o /usr/local/bin/appimagetool && \
    printf '%s  %s\n' "$APPIMAGETOOL_SHA256" /usr/local/bin/appimagetool | sha256sum -c - && \
    chmod 0755 /usr/local/bin/appimagetool

WORKDIR /workspace
